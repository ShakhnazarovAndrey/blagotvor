---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';
import { site, requisites } from '../data/site';

const cards = [
  { icon: 'phone', label: 'Телефон', value: site.phone, href: site.phoneHref },
  { icon: 'mail', label: 'E-mail', value: site.email, href: `mailto:${site.email}` },
  { icon: 'clock', label: 'Режим работы', value: site.hours },
  { icon: 'pin', label: 'Адрес', value: site.address },
];
const inn = requisites.find((r) => r.label === 'ИНН')!.value;
const ogrn = requisites.find((r) => r.label === 'ОГРН')!.value;
---

<BaseLayout title="Контакты" description={`Контакты фонда «Люди Вместе»: ${site.phone}, ${site.email}, ${site.address}.`}>
  <PageHero title="Мы всегда на связи" crumb="Контакты" lead="Позвоните, напишите или приходите к нам в офис — расскажем, как получить помощь или как помочь самим." />

  <section class="section--tight">
    <div class="container">
      <div class="ccards" data-stagger>
        {
          cards.map((c) => {
            const Tag = c.href ? 'a' : 'div';
            return (
              <Tag href={c.href} class="ccard" data-tilt>
                <span class="ccard__icon">
                  <Icon name={c.icon} size={26} />
                </span>
                <span class="ccard__label">{c.label}</span>
                <span class="ccard__value">{c.value}</span>
              </Tag>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container cgrid">
      <div class="map" data-reveal="scale">
        <iframe src={site.mapSrc} title="Фонд «Люди Вместе» на карте" loading="lazy" allowfullscreen></iframe>
        <div class="map__pin">
          <b>БФ «Люди Вместе»</b>
          <span>{site.addressShort}</span>
        </div>
      </div>
      <div class="cform-box" data-reveal>
        <p class="eyebrow">Напишите нам</p>
        <h2>Оставьте сообщение</h2>
        <p class="muted cform-box__lead">Мы свяжемся с вами, чтобы обсудить, как можем помочь.</p>
        <ContactForm topic="Страница «Контакты»" />
      </div>
    </div>
  </section>

  <section class="section--tight">
    <div class="container">
      <div class="social" data-reveal>
        <div>
          <h3>Следите за добрыми делами</h3>
          <p class="muted">Новости, анонсы мероприятий и истории подопечных — в наших соцсетях.</p>
        </div>
        <div class="social__links">
          {
            site.socials.map((s) => (
              <a href={s.href} target="_blank" rel="noopener" class="btn btn--ghost btn--sm" data-magnetic>
                <Icon name={s.icon} size={20} /> {s.name}
              </a>
            ))
          }
        </div>
      </div>
      <p class="legal">{site.name} · ИНН {inn} · ОГРН {ogrn}</p>
    </div>
  </section>
</BaseLayout>

<style>
  .ccards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  .ccard {
    display: flex;
    flex-direction: column;
    gap: 6px;
    background: var(--paper);
    border-radius: var(--r-lg);
    padding: 28px;
    box-shadow: var(--shadow);
    transition: background 0.4s;
  }
  a.ccard:hover {
    background: var(--sun);
  }
  .ccard__icon {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--sun-soft);
    display: grid;
    place-items: center;
    margin-bottom: 18px;
  }
  a.ccard:hover .ccard__icon {
    background: #fff;
  }
  .ccard__label {
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .ccard__value {
    font-weight: 750;
    font-size: 1.05rem;
    line-height: 1.35;
  }
  .cgrid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 24px;
  }
  .map {
    position: relative;
    border-radius: var(--r-lg);
    overflow: hidden;
    min-height: 520px;
    background: var(--bg-2);
    box-shadow: var(--shadow);
  }
  .map iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    filter: saturate(0.85);
  }
  .map__pin {
    position: absolute;
    left: 20px;
    bottom: 20px;
    background: var(--ink);
    color: #fff;
    border-radius: var(--r);
    padding: 16px 20px;
    display: flex;
    flex-direction: column;
    pointer-events: none;
  }
  .map__pin span {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.9rem;
  }
  .cform-box {
    background: var(--paper);
    border-radius: var(--r-lg);
    padding: clamp(28px, 4vw, 48px);
    box-shadow: var(--shadow);
  }
  .cform-box__lead {
    margin: 12px 0 28px;
  }
  .social {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
    background: var(--sun-soft);
    border-radius: var(--r-lg);
    padding: clamp(28px, 4vw, 44px);
  }
  .social h3 {
    margin-bottom: 8px;
  }
  .social__links {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .legal {
    text-align: center;
    color: var(--muted);
    font-size: 0.85rem;
    margin-top: 32px;
  }
  @media (max-width: 1000px) {
    .ccards {
      grid-template-columns: 1fr 1fr;
    }
    .cgrid {
      grid-template-columns: 1fr;
    }
    .map {
      min-height: 380px;
    }
  }
  @media (max-width: 520px) {
    .ccards {
      grid-template-columns: 1fr;
    }
  }
</style>
