---
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsCard from '../../components/NewsCard.astro';
import Icon from '../../components/Icon.astro';
import { fmtDate, cleanTitle, excerpt } from '../../data/format';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const all = (await getCollection('news')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return all.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: all[i - 1] ?? null, older: all[i + 1] ?? null, more: all.filter((p) => p.id !== post.id).slice(0, 12) },
  }));
}

interface Props {
  post: CollectionEntry<'news'>;
  newer: CollectionEntry<'news'> | null;
  older: CollectionEntry<'news'> | null;
  more: CollectionEntry<'news'>[];
}
const { post, newer, older, more } = Astro.props;
const { Content } = await render(post);
const { title, date, cover, gallery } = post.data;
const t = cleanTitle(title);
// «Читайте также» — три соседние по времени новости
const idx = more.findIndex((p) => p.data.date < date);
const related = (idx === -1 ? more.slice(-3) : more.slice(Math.max(0, idx - 1), Math.max(0, idx - 1) + 3)).slice(0, 3);
const url = new URL(`/news/${post.id}/`, site.url).href;
const rest = gallery.slice(1);
---

<BaseLayout title={t} description={excerpt(post.body ?? '', 155)} image={cover} article>
  <article class="art">
    <header class="art__head container">
      <nav class="crumbs" aria-label="Навигационная цепочка" data-reveal="fade">
        <a href="/">Главная</a><span>/</span><a href="/news/">Новости</a>
      </nav>
      <time datetime={date.toISOString()} class="chip chip--sun" data-reveal="fade">{fmtDate(date)}</time>
      <h1 data-split="load">{title}</h1>
    </header>

    {
      cover && (
        <div class="container">
          <a href={cover.src} class="art__cover" data-lightbox="article" data-clip>
            <Image src={cover} alt={t} widths={[600, 1000, 1400]} sizes="(max-width: 1100px) 100vw, 1100px" loading="eager" />
          </a>
        </div>
      )
    }

    <div class="container art__layout">
      <aside class="art__side">
        <div class="art__sticky">
          <a href="/news/" class="art__back">
            <Icon name="arrow-left" size={20} /> Все новости
          </a>
          <p class="art__share-label">Поделиться</p>
          <div class="art__share">
            <a href={`https://vk.com/share.php?url=${encodeURIComponent(url)}`} target="_blank" rel="noopener" aria-label="Поделиться ВКонтакте">
              <Icon name="vk" size={20} />
            </a>
            <a href={`https://t.me/share/url?url=${encodeURIComponent(url)}&text=${encodeURIComponent(t)}`} target="_blank" rel="noopener" aria-label="Поделиться в Telegram">
              <Icon name="tg" size={20} />
            </a>
            <button data-copy={url} aria-label="Скопировать ссылку" class="art__copy">
              <Icon name="copy" size={20} />
              <Icon name="check" size={20} />
            </button>
          </div>
        </div>
      </aside>

      <div class="art__body" data-reveal>
        <Content />

        {
          rest.length > 0 && (
            <div class:list={['art__gallery', `art__gallery--${Math.min(rest.length, 3)}`]}>
              {rest.map((g) => (
                <a href={g.src} data-lightbox="article">
                  <Image src={g} alt={`Фото: ${t}`} widths={[400, 700]} sizes="(max-width: 760px) 50vw, 33vw" />
                </a>
              ))}
            </div>
          )
        }

        <div class="art__cta">
          <div>
            <b>Поддержите добрые дела фонда</b>
            <span>Любая сумма помогает нашим подопечным</span>
          </div>
          <a href="/kak-pomoch/#donate" class="btn btn--sun btn--sm" data-magnetic><Icon name="heart" size={18} /> Помочь</a>
        </div>

        <nav class="art__pn" aria-label="Соседние новости">
          {
            older ? (
              <a href={`/news/${older.id}/`} class="pn pn--prev">
                <span>
                  <Icon name="arrow-left" size={18} /> Предыдущая
                </span>
                <b>{cleanTitle(older.data.title)}</b>
              </a>
            ) : (
              <span />
            )
          }
          {
            newer && (
              <a href={`/news/${newer.id}/`} class="pn pn--next">
                <span>
                  Следующая <Icon name="arrow" size={18} />
                </span>
                <b>{cleanTitle(newer.data.title)}</b>
              </a>
            )
          }
        </nav>
      </div>
    </div>
  </article>

  <section class="section">
    <div class="container">
      <h2 class="more__title" data-split>Читайте также</h2>
      <div class="more" data-stagger>
        {related.map((p) => <NewsCard post={p} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .art__head {
    padding-top: calc(var(--header-h) + clamp(32px, 5vw, 64px));
    padding-bottom: clamp(28px, 4vw, 48px);
    max-width: 1100px;
  }
  .crumbs {
    display: flex;
    gap: 8px;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 20px;
  }
  .crumbs a:hover {
    color: var(--ink);
  }
  .art__head h1 {
    font-size: clamp(1.9rem, 4.2vw, 3.6rem);
    margin-top: 20px;
    max-width: 22ch;
  }
  .art__cover {
    display: block;
    max-width: 1100px;
    margin: 0 auto;
    border-radius: var(--r-lg);
    overflow: hidden;
    max-height: 78vh;
    background: var(--bg-2);
    cursor: zoom-in;
  }
  .art__cover :global(img) {
    width: 100%;
    max-height: 78vh;
    object-fit: contain;
  }
  .art__layout {
    display: grid;
    grid-template-columns: 200px minmax(0, 720px);
    justify-content: center;
    gap: clamp(24px, 5vw, 80px);
    padding-top: clamp(40px, 5vw, 64px);
  }
  .art__sticky {
    position: sticky;
    top: calc(var(--header-h) + 24px);
  }
  .art__back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 800;
    padding: 10px 16px;
    border-radius: 999px;
    background: var(--paper);
    box-shadow: var(--shadow);
    transition: background 0.3s;
  }
  .art__back:hover {
    background: var(--sun);
  }
  .art__share-label {
    margin: 32px 0 10px;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .art__share {
    display: flex;
    gap: 8px;
  }
  .art__share > * {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--paper);
    box-shadow: var(--shadow);
    transition: background 0.3s;
  }
  .art__share > *:hover {
    background: var(--sun);
  }
  .art__copy :global(svg:last-child) {
    display: none;
  }
  .art__copy:global(.is-copied) {
    background: var(--leaf);
    color: #fff;
  }
  .art__copy:global(.is-copied) :global(svg:first-child) {
    display: none;
  }
  .art__copy:global(.is-copied) :global(svg:last-child) {
    display: block;
  }

  .art__body {
    font-size: clamp(1.02rem, 0.3vw + 0.98rem, 1.15rem);
    line-height: 1.75;
    color: var(--ink-2);
  }
  .art__body :global(p) {
    margin-bottom: 1.2em;
  }
  .art__body :global(p:first-of-type) {
    font-size: 1.15em;
    color: var(--ink);
    font-weight: 550;
  }
  .art__body :global(h3) {
    color: var(--ink);
    margin: 1.6em 0 0.6em;
  }
  .art__body :global(ul) {
    padding-left: 1.2em;
  }
  .art__body :global(blockquote) {
    margin: 1.5em 0;
    padding: 16px 24px;
    background: var(--sun-soft);
    border-radius: var(--r-sm);
  }
  .art__gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin: 36px 0;
  }
  .art__gallery--1 {
    grid-template-columns: 1fr;
  }
  .art__gallery--2 {
    grid-template-columns: 1fr 1fr;
  }
  .art__gallery a {
    border-radius: var(--r-sm);
    overflow: hidden;
    aspect-ratio: 1;
    display: block;
    cursor: zoom-in;
  }
  .art__gallery--1 a {
    aspect-ratio: 16 / 10;
  }
  .art__gallery :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease);
  }
  .art__gallery a:hover :global(img) {
    transform: scale(1.08);
  }
  .art__cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    background: var(--sun);
    border-radius: var(--r);
    padding: 22px 26px;
    margin: 40px 0;
    color: var(--ink);
  }
  .art__cta div {
    display: flex;
    flex-direction: column;
    line-height: 1.35;
  }
  .art__cta span {
    font-size: 0.9rem;
  }
  .art__pn {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .pn {
    display: flex;
    flex-direction: column;
    gap: 6px;
    background: var(--paper);
    border-radius: var(--r);
    padding: 18px 20px;
    box-shadow: var(--shadow);
    transition: transform 0.4s var(--ease);
  }
  .pn:hover {
    transform: translateY(-4px);
  }
  .pn span {
    display: inline-flex;
    gap: 6px;
    align-items: center;
    font-size: 0.82rem;
    font-weight: 800;
    color: var(--muted);
  }
  .pn b {
    color: var(--ink);
    font-size: 0.95rem;
    line-height: 1.35;
  }
  .pn--next {
    text-align: right;
    align-items: flex-end;
    grid-column: 2;
  }
  .more__title {
    margin-bottom: 36px;
  }
  .more {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  @media (max-width: 900px) {
    .art__layout {
      grid-template-columns: 1fr;
    }
    .art__sticky {
      position: static;
      display: flex;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
    }
    .art__share-label {
      margin: 0 0 0 auto;
    }
    .more {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .art__pn {
      grid-template-columns: 1fr;
    }
    .pn--next {
      grid-column: auto;
    }
    .art__gallery {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
