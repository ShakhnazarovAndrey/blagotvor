---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site, footerNav } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__cta container">
    <div class="footer__cta-text" data-reveal>
      <p class="eyebrow">Присоединяйтесь</p>
      <h2>Вместе — значит <span class="hl" data-hl>сильнее</span></h2>
      <p class="lead">
        Каждый может внести свой вклад: помочь делом, временем, вниманием или пожертвованием. Добро не требует
        многого — только участия.
      </p>
    </div>
    <div class="footer__cta-actions" data-reveal>
      <a href="/kak-pomoch/#donate" class="btn btn--sun" data-magnetic>
        <Icon name="heart" size={20} /> Пожертвовать
      </a>
      <a href="#request" class="btn btn--light" data-magnetic>Стать волонтёром</a>
    </div>
  </div>

  <div class="footer__main container">
    <div class="footer__brand">
      <Logo light />
      <p>Мы объединяем тех, кто нуждается в помощи, и тех, кто готов помогать. Вместе мы можем больше.</p>
      <div class="footer__socials">
        {
          site.socials.map((s) => (
            <a href={s.href} target="_blank" rel="noopener" aria-label={s.name} data-magnetic>
              <Icon name={s.icon} size={22} />
            </a>
          ))
        }
      </div>
    </div>

    <div class="footer__col">
      <h4>Контакты</h4>
      <a href={site.phoneHref} class="footer__big">{site.phone}</a>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <p>{site.hours}</p>
      <p>{site.address}</p>
    </div>

    <div class="footer__col">
      <h4>Информация</h4>
      {footerNav.info.map((l) => <a href={l.href}>{l.label}</a>)}
    </div>

    <div class="footer__col">
      <h4>Важное</h4>
      {footerNav.important.map((l) => <a href={l.href}>{l.label}</a>)}
    </div>
  </div>

  <div class="footer__giant" aria-hidden="true">
    <div class="footer__giant-track" data-marquee="40">
      <span>Люди Вместе ✦ Единство, которое меняет ✦&nbsp;</span>
      <span>Люди Вместе ✦ Единство, которое меняет ✦&nbsp;</span>
    </div>
  </div>

  <div class="footer__bottom container">
    <span>© {site.name}, {year}. Все права защищены.</span>
    <a href="/privacy/">Политика обработки персональных данных</a>
  </div>
</footer>

<style>
  .footer {
    background: var(--ink);
    color: #fff;
    border-radius: var(--r-lg) var(--r-lg) 0 0;
    padding-top: clamp(64px, 8vw, 110px);
    overflow: hidden;
    position: relative;
  }
  .footer h2 {
    color: #fff;
  }
  .footer .hl {
    color: var(--ink);
    padding: 0 0.18em;
    margin-left: 0.04em;
    display: inline-block;
  }
  .footer .hl::after {
    left: 0;
    right: 0;
    top: 0.06em;
    bottom: -0.06em;
    height: auto;
    border-radius: 0.22em;
  }
  .footer .eyebrow {
    color: rgba(255, 255, 255, 0.7);
  }
  .footer .eyebrow::before {
    box-shadow: 0 0 0 4px rgba(255, 209, 46, 0.25);
  }
  .footer .lead {
    color: rgba(255, 255, 255, 0.7);
    max-width: 560px;
    margin-top: 20px;
  }
  .footer__cta {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 40px;
    align-items: end;
    padding-bottom: clamp(48px, 6vw, 80px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }
  .footer__cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: flex-end;
  }
  .footer__main {
    display: grid;
    grid-template-columns: 1.3fr 1.2fr 0.8fr 0.8fr;
    gap: 40px;
    padding-block: clamp(48px, 6vw, 72px);
  }
  .footer__brand p {
    color: rgba(255, 255, 255, 0.6);
    margin-top: 20px;
    max-width: 320px;
  }
  .footer__socials {
    display: flex;
    gap: 10px;
    margin-top: 24px;
  }
  .footer__socials a {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: rgba(255, 255, 255, 0.08);
    transition:
      background 0.3s,
      color 0.3s;
  }
  .footer__socials a:hover {
    background: var(--sun);
    color: var(--ink);
  }
  .footer__col {
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 0.95rem;
  }
  .footer__col h4 {
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sun);
    margin-bottom: 8px;
    font-family: var(--font-body);
    font-weight: 800;
  }
  .footer__col a {
    color: rgba(255, 255, 255, 0.85);
    width: fit-content;
    background: linear-gradient(var(--sun), var(--sun)) left bottom / 0 2px no-repeat;
    transition: background-size 0.4s var(--ease);
  }
  .footer__col a:hover {
    background-size: 100% 2px;
    color: #fff;
  }
  .footer__col p {
    color: rgba(255, 255, 255, 0.55);
    margin: 0;
  }
  .footer__big {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: #fff !important;
  }
  .footer__giant {
    overflow: hidden;
    padding-block: 8px;
    user-select: none;
  }
  .footer__giant-track {
    display: flex;
    width: max-content;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(3.5rem, 11vw, 10rem);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(255, 209, 46, 0.55);
    white-space: nowrap;
  }
  .footer__bottom {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding-block: 28px;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.5);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }
  .footer__bottom a:hover {
    color: var(--sun);
  }

  @media (max-width: 960px) {
    .footer__cta {
      grid-template-columns: 1fr;
    }
    .footer__cta-actions {
      justify-content: flex-start;
    }
    .footer__main {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .footer__main {
      grid-template-columns: 1fr;
    }
  }
</style>
