---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { fmtDate, cleanTitle, leadEmoji, excerpt } from '../data/format';
import logoFallback from '../assets/site/pic_ins_pr.jpg';

interface Props {
  post: CollectionEntry<'news'>;
  big?: boolean;
  filterable?: boolean;
}
const { post, big = false, filterable = false } = Astro.props;
const { title, date, cover, gallery } = post.data;
const t = cleanTitle(title);
const emoji = leadEmoji(title);
const text = excerpt(post.body ?? '', big ? 220 : 120);
---

<a
  href={`/news/${post.id}/`}
  class:list={['ncard', { 'ncard--big': big }]}
  data-news-card={filterable ? '' : undefined}
  data-year={filterable ? String(date.getFullYear()) : undefined}
  data-search={filterable ? `${t} ${text}`.toLowerCase() : undefined}
>
  <div class="ncard__media">
    <Image
      src={cover ?? logoFallback}
      alt={t}
      widths={big ? [600, 900, 1200] : [400, 600, 800]}
      sizes={big ? '(max-width: 900px) 100vw, 60vw' : '(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw'}
    />
    {gallery.length > 1 && <span class="ncard__photos">{gallery.length} фото</span>}
    {emoji && <span class="ncard__emoji">{emoji}</span>}
  </div>
  <div class="ncard__body">
    <time datetime={date.toISOString()}>{fmtDate(date)}</time>
    <h3>{t}</h3>
    {big && <p>{text}</p>}
    <span class="ncard__more">Читать <span aria-hidden="true">→</span></span>
  </div>
</a>

<style>
  .ncard {
    display: flex;
    flex-direction: column;
    background: var(--paper);
    border-radius: var(--r-lg);
    overflow: hidden;
    box-shadow: var(--shadow);
    transition:
      transform 0.6s var(--ease),
      box-shadow 0.6s var(--ease);
    height: 100%;
  }
  .ncard[hidden] {
    display: none;
  }
  .ncard:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-lg);
  }
  .ncard__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--bg-2);
  }
  .ncard__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s var(--ease);
  }
  .ncard:hover .ncard__media :global(img) {
    transform: scale(1.08);
  }
  .ncard__photos {
    position: absolute;
    left: 14px;
    bottom: 14px;
    background: rgba(22, 22, 27, 0.7);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 5px 12px;
    border-radius: 999px;
    backdrop-filter: blur(6px);
  }
  .ncard__emoji {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: #fff;
    display: grid;
    place-items: center;
    font-size: 1.3rem;
    box-shadow: var(--shadow);
    transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .ncard:hover .ncard__emoji {
    transform: rotate(-15deg) scale(1.15);
  }
  .ncard__body {
    padding: 22px 24px 26px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }
  .ncard__body time {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--muted);
  }
  .ncard__body h3 {
    font-size: 1.08rem;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .ncard__body p {
    color: var(--ink-2);
    font-size: 0.95rem;
  }
  .ncard__more {
    margin-top: auto;
    padding-top: 8px;
    font-weight: 800;
    font-size: 0.9rem;
    display: inline-flex;
    gap: 6px;
  }
  .ncard__more span {
    transition: transform 0.4s var(--ease);
  }
  .ncard:hover .ncard__more span {
    transform: translateX(6px);
  }
  .ncard--big h3 {
    font-size: clamp(1.3rem, 2vw, 1.8rem);
  }
  .ncard--big .ncard__media {
    aspect-ratio: 16 / 10;
  }
</style>
